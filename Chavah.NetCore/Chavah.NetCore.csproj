<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>c9b7e1c3-1564-4d7d-85ea-3455587a330d</UserSecretsId>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <AssemblyName>BitShuva.Chavah</AssemblyName>
    <RootNamespace>BitShuva.Chavah</RootNamespace>
    <CodeAnalysisRuleSet>..\Chavah.ruleset</CodeAnalysisRuleSet>
    <nullable>enable</nullable>
    <!-- The Vite client is a self-contained npm/Vite project; keep it out of the .NET SDK's
         default Compile/Content/None globs (it builds via the BuildClient target). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);client\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DocumentationFile></DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DocumentationFile>D:\Dev\Chavah\Chavah.NetCore\BitShuva.Chavah.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.1" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Bet.Extensions.AzureVault" Version="3.1.10" />
    <PackageReference Include="Bet.AspNetCore.HealthChecks" Version="3.1.10" />
    <PackageReference Include="BunnyCDN.Net.Storage" Version="1.0.4" />
    <PackageReference Include="CodeHollow.FeedReader" Version="1.2.6" />
    <PackageReference Include="CoreFtp" Version="1.4.0" />
    <PackageReference Include="DalSoft.Hosting.BackgroundQueue" Version="1.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="5.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Versioning.ApiExplorer" Version="4.2.0" />
    <PackageReference Include="Microsoft.Extensions.PlatformAbstractions" Version="1.1.0" />
    <PackageReference Include="Microsoft.SyndicationFeed.ReaderWriter" Version="1.0.2" />
    <PackageReference Include="PayPalServerSDK" Version="0.6.1" />
    <PackageReference Include="Pwned.AspNetCore" Version="2.0.0" />
    <PackageReference Include="Quartz" Version="3.8.0" />
    <PackageReference Include="RavenDB.Client" Version="7.2.0" />
    <PackageReference Include="RavenDB.Identity" Version="9.0.1" />
    <PackageReference Include="RavenDB.StructuredLogger" Version="7.1.0" />
    <PackageReference Include="RavenMigrations" Version="6.0.2" />
    <PackageReference Include="RavenDB.DependencyInjection" Version="5.0.1" />
    <PackageReference Include="Sendgrid" Version="9.29.3" />
    <PackageReference Include="SimpleSitemap" Version="3.2.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="5.6.3" />
    <PackageReference Include="System.Interactive" Version="5.0.0" />
    <PackageReference Include="System.ServiceModel.Syndication" Version="5.0.0" />
    <PackageReference Include="WebPush" Version="1.0.12" />
    <PackageReference Include="Polly" Version="8.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="App_Data\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="ravencert.Development.pfx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="ravencert.Production.pfx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="npm install" />
  </Target>

  <!-- In Release, build the Vite client into wwwroot so it can be served/published. In Debug the Vite dev server serves the client. -->
  <Target Name="BuildClient" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="npm install" WorkingDirectory="client" />
    <Exec Command="npm run build" WorkingDirectory="client" />
  </Target>

</Project>
