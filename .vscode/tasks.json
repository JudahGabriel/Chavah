{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-backend",
      "detail": "dotnet build of the Chavah ASP.NET Core project",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Chavah/Chavah.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    }
  ]
}
